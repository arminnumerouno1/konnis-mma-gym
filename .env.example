# Öffentliche Live-URL ohne Slash am Ende.
# VITE_SITE_URL=https://www.mma-in-leipzig.de
# SITE_URL=https://www.mma-in-leipzig.de

# Optional: Brevo für Mitglieder- und Wartelisten-Kontakte
# BREVO_API_KEY=
# BREVO_LIST_ID=
# BREVO_DOI_TEMPLATE_ID=
# BREVO_DOI_REDIRECT_URL=https://mma-in-leipzig.de/?liste=bestaetigt

# HMAC für First-50-Einladungslinks. Mindestens 16 Zeichen.
# Gleicher Wert beim Erzeugen der Links und auf Vercel (Production).
# INVITE_SECRET=

# Passwort für /verwaltung. Mindestens 16 Zeichen.
# Fehlt es, gilt INVITE_SECRET (besser eigenen Wert setzen).
# ADMIN_SECRET=

# Ops-Beweis für CLI-Mails (Invites, Vertragsmail, Pay-Link). Mindestens 24 Zeichen.
# NICHT für Broadcast — Broadcast nur mit Admin-Login.
# Nie als Cron-Secret wiederverwenden.
# SIGNUP_MAIL_PROOF=

# Vercel Cron Auth für /api/dues-cron. Eigenen Wert setzen (kein Fallback auf SIGNUP_MAIL_PROOF).
# CRON_SECRET=

# Optional: Vercel Blob, damit Mitgliederdaten auf Vercel bleiben.
# BLOB_READ_WRITE_TOKEN=

# Optional: Postfach für neue Mitgliedsanträge (sonst Absender info@…)
# MEMBERSHIP_NOTIFY_EMAIL=info@mma-in-leipzig.de

# Optional: Webhook für neue Mitgliedsanträge / Probetraining
# MEMBERSHIP_WEBHOOK_URL=https://hook.example.com/mitglied
# CONTACT_WEBHOOK_URL=https://hook.example.com/kontakt
# WAITLIST_WEBHOOK_URL=https://hook.example.com/waitlist

# Stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
