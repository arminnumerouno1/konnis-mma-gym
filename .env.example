# Öffentliche Live-URL ohne Slash am Ende.
# Setzt Canonical, Open-Graph-URLs, Sitemap und den Double-Opt-in-Redirect.
# VITE_SITE_URL=https://mma-in-leipzig.de

# Warteliste: optional Brevo (EU). Ohne Keys werden Einträge nur lokal in data/waitlist.json gespeichert.
# BREVO_API_KEY=xkeysib-...
# BREVO_LIST_ID=2
# BREVO_DOI_TEMPLATE_ID=1
# BREVO_DOI_REDIRECT_URL=https://mma-in-leipzig.de/?liste=bestaetigt

# Oder ein eingehender Webhook (Make, Zapier, n8n):
# WAITLIST_WEBHOOK_URL=https://hook.example.com/waitlist
