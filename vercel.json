{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/dues-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/mitglied.js": {
      "includeFiles": "public/legal/widerrufsbelehrung.pdf"
    },
    "api/invite-mail.js": {
      "includeFiles": "public/legal/widerrufsbelehrung.pdf"
    },
    "api/signup-open-mail.js": {
      "maxDuration": 60
    },
    "api/dues-cron.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "includeFiles": "public/legal/widerrufsbelehrung.pdf,server/assets/widerrufsbelehrung.pdf"
    }
  },
  "redirects": [
    { "source": "/legal/agb.pdf", "destination": "/agb", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-6-monate.pdf", "destination": "/vertrag/6", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-12-monate.pdf", "destination": "/vertrag/12", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-24-monate.pdf", "destination": "/vertrag/24", "permanent": true },
    { "source": "/voranmeldung", "destination": "/mitglied", "permanent": true }
  ],
  "rewrites": [
    { "source": "/mitglied", "destination": "/index.html" },
    { "source": "/portrait", "destination": "/index.html" },
    { "source": "/verwaltung", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/index.html" },
    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/agb", "destination": "/index.html" },
    { "source": "/widerruf", "destination": "/index.html" },
    { "source": "/hausordnung", "destination": "/index.html" },
    { "source": "/vertrag/6", "destination": "/index.html" },
    { "source": "/vertrag/12", "destination": "/index.html" },
    { "source": "/vertrag/24", "destination": "/index.html" }
  ]
}
