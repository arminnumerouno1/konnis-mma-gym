{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(), geolocation=()" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https://api.stripe.com https://js.stripe.com https://m.stripe.network https://checkout.stripe.com; frame-src https://js.stripe.com https://hooks.stripe.com https://checkout.stripe.com; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/dues-cron",
      "schedule": "0 7 * * *"
    }
  ],
  "functions": {
    "api/mitglied.js": {
      "includeFiles": "public/legal/widerrufsbelehrung.pdf"
    },
    "api/invite-mail.js": {
      "includeFiles": "public/legal/widerrufsbelehrung.pdf"
    },
    "api/signup-open-mail.js": {
      "maxDuration": 60
    },
    "api/dues-cron.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "includeFiles": "public/legal/widerrufsbelehrung.pdf,server/assets/widerrufsbelehrung.pdf"
    }
  },
  "redirects": [
    { "source": "/legal/agb.pdf", "destination": "/agb", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-6-monate.pdf", "destination": "/vertrag/6", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-12-monate.pdf", "destination": "/vertrag/12", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-24-monate.pdf", "destination": "/vertrag/24", "permanent": true },
    { "source": "/voranmeldung", "destination": "/mitglied", "permanent": true }
  ],
  "rewrites": [
    { "source": "/mitglied", "destination": "/index.html" },
    { "source": "/portrait", "destination": "/index.html" },
    { "source": "/verwaltung", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/index.html" },
    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/agb", "destination": "/index.html" },
    { "source": "/widerruf", "destination": "/index.html" },
    { "source": "/hausordnung", "destination": "/index.html" },
    { "source": "/vertrag/6", "destination": "/index.html" },
    { "source": "/vertrag/12", "destination": "/index.html" },
    { "source": "/vertrag/24", "destination": "/index.html" }
  ]
}
