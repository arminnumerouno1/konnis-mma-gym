{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/legal/agb.pdf", "destination": "/agb", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-12-monate.pdf", "destination": "/vertrag/12", "permanent": true },
    { "source": "/legal/mitgliedsvertrag-24-monate.pdf", "destination": "/vertrag/24", "permanent": true }
  ],
  "rewrites": [
    { "source": "/mitglied", "destination": "/index.html" },
    { "source": "/impressum", "destination": "/index.html" },
    { "source": "/datenschutz", "destination": "/index.html" },
    { "source": "/agb", "destination": "/index.html" },
    { "source": "/widerruf", "destination": "/index.html" },
    { "source": "/hausordnung", "destination": "/index.html" },
    { "source": "/vertrag/12", "destination": "/index.html" },
    { "source": "/vertrag/24", "destination": "/index.html" }
  ]
}
